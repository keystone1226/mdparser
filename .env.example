# ===== 서버 설정 =====
# 바인딩 호스트 (팀 공유 시 0.0.0.0, 본인만 사용 시 127.0.0.1)
HOST=0.0.0.0
PORT=8000

# ===== 파일 제한 =====
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=10

# 변환 결과 보관 시간 (시간 단위, 0 이면 비활성)
RETENTION_HOURS=24

# ===== Fabrix LLM 연동 (이미지 설명 / OCR) =====
# 아래 값을 모두 채우면 이미지 캡션/OCR 기능이 자동 활성화됩니다.
# 발급 받은 Open API Endpoint URL (예: https://xxx.samsung.com/openapi/llm/v1)
FABRIX_ENDPOINT_URL=
# x-fabrix-client 헤더 값
FABRIX_CLIENT_KEY=
# x-openapi-token 헤더 값 (예: "Bearer eyJXXX..." 형식이면 그대로 붙여넣기)
FABRIX_OPENAPI_TOKEN=
# x-llm-model-id 헤더 값 (/v1/models 조회 후 확인)
FABRIX_MODEL_ID=
# chat/completions 요청 body 의 model 값 (모델 관리자에게 확인)
FABRIX_MODEL_NAME=gpt-4o
# (옵션) x-generative-ai-user-email 헤더 값
FABRIX_USER_EMAIL=
